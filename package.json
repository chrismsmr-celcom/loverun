    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@mapbox/mapbox-gl": "^3.7.0",
    "@supabase/supabase-js": "^2.45.4",
    "html2canvas": "^1.4.1",
